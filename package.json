{
  "name": "dsh-canvas-viewer",
  "version": "0.4.15",
  "description": "DeepSeek Harness plugin + dsh-native canvas-analysis-report skill: open .canvas.tsx reports in a floating viewer with a settings library.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JUANWANG-BUAA/dsh-canvas-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/JUANWANG-BUAA/dsh-canvas-viewer/issues"
  },
  "homepage": "https://github.com/JUANWANG-BUAA/dsh-canvas-viewer#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "canvas",
    "cursor-canvas"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/preview.mjs",
    "lib/host",
    "src",
    "tsconfig.json",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE",
    "AGENTS.md",
    "docs",
    "skills",
    "scripts"
  ],
  "scripts": {
    "test": "node scripts/sync-skill-mirrors.mjs --check && pnpm typecheck && node scripts/syntax-check.mjs && node scripts/package-contract.mjs && node scripts/client-contract.mjs && node scripts/self-test.mjs && node scripts/budget-report.mjs && node scripts/cordis-lifecycle.mjs && node scripts/regression.mjs && node scripts/sandbox-e2e.mjs",
    "test:sandbox": "node scripts/sandbox-e2e.mjs",
    "test:lifecycle": "node scripts/cordis-lifecycle.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:dsh": "node scripts/dsh-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "build:host": "tsc -p tsconfig.json",
    "test:client": "node scripts/client-contract.mjs",
    "test:syntax": "node scripts/syntax-check.mjs",
    "test:compile": "node scripts/compile-sample.mjs",
    "test:regression": "node scripts/regression.mjs",
    "test:budget": "node scripts/budget-report.mjs",
    "open:sample": "node scripts/open-sample.mjs",
    "sync:skills": "node scripts/sync-skill-mirrors.mjs",
    "sync:dsh": "bash scripts/sync-install.sh"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "sucrase": "^3.35.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^22.15.0",
    "playwright": "^1.62.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.8.3"
  }
}
