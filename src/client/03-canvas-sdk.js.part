            var pct = total ? Math.round((Number(d.value) || 0) / total * 100) : 0;
            return h("span", { key: i },
              h("i", { style: { background: color } }),
              (d.label || d.name || ("项 " + (i + 1))) + " · " + (Number(d.value) || 0) + suffix + " (" + pct + "%)",
            );
          }),
