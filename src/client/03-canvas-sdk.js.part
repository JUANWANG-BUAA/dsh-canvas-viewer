        var yFor = function (v) { return plotBottom - ((v - yMin) / spanY) * plotH; };
        var xFor = function (i, n) { return padL + (i * (width - padL - padR)) / Math.max(n - 1, 1); };
        var els = [];
        tickValues.forEach(function (t) {
